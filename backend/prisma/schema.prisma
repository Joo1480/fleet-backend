generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventGroup {
  EFETIVO
  MANOBRA
  DESLOCAMENTO
  AGUARDANDO
  MANUTENCAO
}

model Machine {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  type      String
  model      String
  brand      String
  year       Int

  events    Event[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("machines")
}

model Event {
  id String @id

  machineCode String @map("machine_code")

  machine Machine @relation(fields: [machineCode], references: [code])

  eventGroup EventGroup @map("event_group")

  startTime DateTime  @map("start_time")
  endTime   DateTime? @map("end_time")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([machineCode])
  @@index([startTime])
  @@index([endTime])
  @@index([machineCode, startTime])

  @@map("events")
}